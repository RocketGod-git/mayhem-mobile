<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- HackRF-direct targets (libhackrf USB vendor protocol). Vendor 0x1d50 = 7504.
         HackRF One / One r9 / HackRF Pro "Praline" (shares PID 0x6089 = 24713; told apart by BOARD_ID_READ). -->
    <usb-device vendor-id="7504" product-id="24713" />
    <!-- Jawbreaker (0x604b = 24651) -->
    <usb-device vendor-id="7504" product-id="24651" />
    <!-- rad1o (0xcc15 = 52245) -->
    <usb-device vendor-id="7504" product-id="52245" />
    <!-- RTL-SDR dongles (receive only): Realtek 0x0bda = 3034 with the RTL2832U 0x2832 = 10290 and the RTL2838
         0x2838 = 10296 almost every dongle reports, plus the rebadged sticks librtlsdr knows. -->
    <usb-device vendor-id="3034" product-id="10290" />
    <usb-device vendor-id="3034" product-id="10296" />
    <usb-device vendor-id="3277" product-id="169" />
    <usb-device vendor-id="3277" product-id="179" />
    <usb-device vendor-id="5460" product-id="20512" />
    <usb-device vendor-id="6235" product-id="1568" />
    <usb-device vendor-id="6235" product-id="1616" />
    <usb-device vendor-id="8013" product-id="47107" />
    <usb-device vendor-id="8013" product-id="51203" />
    <!-- NOT listed on purpose: 1d50:6018 is a PortaPack running Mayhem firmware in its USB-CDC SERIAL mode
         (the Mayhem shell path). This app is the HackRF-direct path: put the PortaPack in "HackRF" mode and it
         enumerates as 0x6089 above. -->
</resources>
