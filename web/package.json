{
  "name": "mayhem-mobile-web",
  "version": "0.4.0",
  "private": true,
  "description": "Mayhem Mobile in the browser: HackRF over WebUSB, DSP in a worker.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle",
    "bundle": "esbuild app=src/main.ts dsp-worker=src/dsp.worker.ts --bundle --format=esm --target=es2020 --minify --legal-comments=none --outdir=build --log-level=warning",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/w3c-web-usb": "1.0.10",
    "esbuild": "0.28.2",
    "typescript": "5.6.3"
  }
}
