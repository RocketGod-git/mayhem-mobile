{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["w3c-web-usb"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false,
    "removeComments": true
  },
  "include": ["src/**/*.ts"]
}
